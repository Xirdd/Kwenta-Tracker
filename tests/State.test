import { describe, it, expect, beforeEach } from "vitest";
import {
  state,
  DATA,
  periodRange,
  shiftMonth,
  halfOfKey,
  monthLabel,
  monthPortionOf,
  monthTx,
  totals,
  budgetFor,
  isSeparatelyTracked,
} from "../src/state.js";

beforeEach(() => {
  DATA.salary = {};
  DATA.transactions = [];
  DATA.budgets = {};
  DATA.budgetsSecond = {};
});

describe("period ranges", () => {
  it("splits a month into 1st–15th and 16th–end", () => {
    expect(periodRange("2026-09-1")).toEqual({ start: "2026-09-01", end: "2026-09-15" });
    expect(periodRange("2026-09-2")).toEqual({ start: "2026-09-16", end: "2026-09-30" });
  });
  it("knows how long February really is", () => {
    expect(periodRange("2028-02-2").end).toBe("2028-02-29"); // leap year
    expect(periodRange("2027-02-2").end).toBe("2027-02-28");
    expect(periodRange("2026-12-2").end).toBe("2026-12-31");
  });
  it("monthly keys cover the whole month", () => {
    expect(periodRange("2026-09")).toEqual({ start: "2026-09-01", end: "2026-09-30" });
  });
});

describe("shifting periods", () => {
  it("rolls over the year in both directions (semi-monthly)", () => {
    state.monthKey = "2026-12-2";
    shiftMonth(1);
    expect(state.monthKey).toBe("2027-01-1");
    shiftMonth(-1);
    expect(state.monthKey).toBe("2026-12-2");
  });
  it("moves half by half", () => {
    state.monthKey = "2026-09-1";
    shiftMonth(1);
    expect(state.monthKey).toBe("2026-09-2");
    shiftMonth(1);
    expect(state.monthKey).toBe("2026-10-1");
  });
  it("rolls over the year in monthly mode", () => {
    state.monthKey = "2026-12";
    shiftMonth(1);
    expect(state.monthKey).toBe("2027-01");
    shiftMonth(-2);
    expect(state.monthKey).toBe("2026-11");
  });
  it("clears the expense filters when the period changes", () => {
    state.monthKey = "2026-09-1";
    state.expenseFilters = { query: "x", category: "rent", wallet: "w1" };
    shiftMonth(1);
    expect(state.expenseFilters).toEqual({ query: "", category: null, wallet: null });
  });
});

describe("period helpers", () => {
  it("reads the half and the calendar month", () => {
    expect(halfOfKey("2026-09-2")).toBe(2);
    expect(halfOfKey("2026-09-1")).toBe(1);
    expect(halfOfKey("2026-09")).toBe(1); // monthly mode has no second half
    expect(monthPortionOf("2026-09-2")).toBe("2026-09");
  });
  it("labels both shapes", () => {
    expect(monthLabel("2026-09")).toBe("September 2026");
    expect(monthLabel("2026-09-2")).toContain("16");
  });
});

describe("which transactions belong to a period", () => {
  it("uses date ranges, not string prefixes (2026-09-10 is NOT in 2026-09-2, 09-01 IS in -1)", () => {
    state.monthKey = "2026-09-1";
    DATA.transactions = [
      { id: "a", type: "expense", amount: 1, date: "2026-09-01" },
      { id: "b", type: "expense", amount: 1, date: "2026-09-10" },
      { id: "c", type: "expense", amount: 1, date: "2026-09-16" },
    ];
    expect(monthTx("expense").map((t) => t.id)).toEqual(["a", "b"]);
    state.monthKey = "2026-09-2";
    expect(monthTx("expense").map((t) => t.id)).toEqual(["c"]);
  });
});

describe("totals (Net Balance)", () => {
  it("salary + extra income − expenses, exact to the centavo", () => {
    state.monthKey = "2026-09-1";
    DATA.salary["2026-09-1"] = 10000.1;
    DATA.transactions = [
      { id: "i", type: "income", amount: 0.2, date: "2026-09-02" },
      { id: "e", type: "expense", amount: 500.05, date: "2026-09-03" },
    ];
    const t = totals();
    expect(t.totalIncome).toBe(10000.3);
    expect(t.totalExpense).toBe(500.05);
    expect(t.balance).toBeCloseTo(9500.25, 10);
  });

  it("keeps goal contributions and utang out of Net Balance", () => {
    state.monthKey = "2026-09-1";
    DATA.transactions = [
      { id: "g", type: "expense", amount: 1000, date: "2026-09-02", goalId: "goal1" },
      { id: "l", type: "expense", amount: 500, date: "2026-09-02", loanId: "loan1" },
      { id: "n", type: "expense", amount: 40, date: "2026-09-02" },
    ];
    expect(isSeparatelyTracked(DATA.transactions[0])).toBe(true);
    expect(isSeparatelyTracked(DATA.transactions[1])).toBe(true);
    expect(totals().totalExpense).toBe(40);
  });

  it("keeps wallet-to-wallet transfers out of Net Balance and Expenses", () => {
    state.monthKey = "2026-09-1";
    DATA.transactions = [
      { id: "t1", type: "expense", amount: 700, date: "2026-09-02", walletId: "a", transferId: "x1" },
      { id: "t2", type: "income", amount: 700, date: "2026-09-02", walletId: "b", transferId: "x1" },
    ];
    expect(isSeparatelyTracked(DATA.transactions[0])).toBe(true);
    const t = totals();
    expect(t.totalExpense).toBe(0);
    expect(t.totalIncome).toBe(0);
  });
});

describe("budget limits per half", () => {
  it("the 2nd half inherits the 1st unless it has its own (even an explicit 0)", () => {
    DATA.budgets.rent = 5000;
    expect(budgetFor("rent", "2026-09-1")).toBe(5000);
    expect(budgetFor("rent", "2026-09-2")).toBe(5000);
    DATA.budgetsSecond.rent = 4000;
    expect(budgetFor("rent", "2026-09-2")).toBe(4000);
    DATA.budgetsSecond.rent = 0;
    expect(budgetFor("rent", "2026-09-2")).toBe(0); // "no limit this half"
    expect(budgetFor("rent", "2026-09-1")).toBe(5000);
  });
  it("monthly keys always use the single limit", () => {
    DATA.budgets.food = 3000;
    DATA.budgetsSecond.food = 1;
    expect(budgetFor("food", "2026-09")).toBe(3000);
  });
});