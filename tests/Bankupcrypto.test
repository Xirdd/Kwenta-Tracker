import { describe, it, expect } from "vitest";
import {
  encryptJSON,
  decryptEnvelope,
  isEncryptedEnvelope,
} from "../src/backupCrypto.js";

describe("encrypted backups", () => {
  const payload = { kwentaBackupVersion: 1, data: { transactions: [{ id: "a", amount: 12.5 }] } };

  it("round-trips with the right password", async () => {
    const env = await encryptJSON(payload, "correct horse battery");
    expect(isEncryptedEnvelope(env)).toBe(true);
    expect(await decryptEnvelope(env, "correct horse battery")).toEqual(payload);
  });

  it("does not leak the plaintext", async () => {
    const env = await encryptJSON(payload, "pw-12345678");
    expect(JSON.stringify(env)).not.toContain("transactions");
  });

  it("fails loudly on a wrong password", async () => {
    const env = await encryptJSON(payload, "right-password");
    await expect(decryptEnvelope(env, "wrong-password")).rejects.toThrow(/Couldn't unlock/);
  });

  it("fails loudly if the file was tampered with", async () => {
    const env = await encryptJSON(payload, "right-password");
    const bytes = Buffer.from(env.ciphertext, "base64");
    bytes[0] ^= 0xff;
    await expect(
      decryptEnvelope({ ...env, ciphertext: bytes.toString("base64") }, "right-password"),
    ).rejects.toThrow();
  });

  it("uses a fresh salt and IV every time", async () => {
    const a = await encryptJSON(payload, "pw-12345678");
    const b = await encryptJSON(payload, "pw-12345678");
    expect(a.salt).not.toBe(b.salt);
    expect(a.iv).not.toBe(b.iv);
    expect(a.ciphertext).not.toBe(b.ciphertext);
  });
});