import { describe, it, expect } from "vitest";
import { escapeHtml, csvEscape, formatDate } from "../src/format.js";

describe("escapeHtml (XSS guard for names that other members can set)", () => {
  it("escapes every HTML-significant character", () => {
    expect(escapeHtml(`<img src=x onerror="a('b')">&`)).toBe(
      "&lt;img src=x onerror=&quot;a(&#39;b&#39;)&quot;&gt;&amp;",
    );
  });
  it("is safe on non-strings", () => {
    expect(escapeHtml(123)).toBe("123");
  });
});

describe("csvEscape (spreadsheet formula injection)", () => {
  it("neutralises cells that start like a formula", () => {
    for (const bad of ["=1+1", "+1", "-1", "@SUM(A1)", "\tcmd"]) {
      expect(csvEscape(bad).startsWith("'")).toBe(true);
    }
  });
  it("quotes commas, quotes and newlines", () => {
    expect(csvEscape("a,b")).toBe('"a,b"');
    expect(csvEscape('say "hi"')).toBe('"say ""hi"""');
    expect(csvEscape("a\nb")).toBe('"a\nb"');
  });
  it("leaves plain text and null alone", () => {
    expect(csvEscape("Jollibee")).toBe("Jollibee");
    expect(csvEscape(null)).toBe("");
  });
});

describe("formatDate", () => {
  it("formats an ISO date without a timezone shift", () => {
    expect(formatDate("2026-09-01")).toBe("Sep 1");
    expect(formatDate("")).toBe("");
  });
});